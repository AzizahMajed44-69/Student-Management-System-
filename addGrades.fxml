<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="460.0" prefWidth="565.0"
            style="-fx-background-color: #1e3d59;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.project.AddGradesController">
   <children>

      <!-- Title -->
      <Label layoutX="91.0" layoutY="14.0" prefHeight="17.0" prefWidth="215.0"
             text="Add Student Grades" textFill="WHITE">
         <font><Font size="24.0" /></font>
      </Label>

      <!-- Student ID -->
      <Label layoutX="44.0" layoutY="71.0" prefHeight="17.0" prefWidth="94.0"
             text="Student ID:" textFill="WHITE" />
      <TextField fx:id="studentIdTxt" layoutX="181.0" layoutY="67.0"
                 prefHeight="25.0" prefWidth="151.0" />

      <!-- Student Name display -->
      <Label fx:id="studentNameLbl" layoutX="44.0" layoutY="104.0"
             prefHeight="17.0" prefWidth="280.0"
             style="-fx-background-color: gray;"
             text="   Student Name:" textFill="WHITE" />

      <!-- Grades -->
      <Label layoutX="44.0" layoutY="148.0" prefHeight="17.0" prefWidth="120.0"
             text="Subject 1 (Math):" textFill="WHITE" />
      <TextField fx:id="grade1Txt" layoutX="181.0" layoutY="144.0"
                 prefHeight="25.0" prefWidth="151.0" />

      <Label layoutX="44.0" layoutY="183.0" prefHeight="17.0" prefWidth="120.0"
             text="Subject 2 (OOP):" textFill="WHITE" />
      <TextField fx:id="grade2Txt" layoutX="181.0" layoutY="179.0"
                 prefHeight="25.0" prefWidth="151.0" />

      <Label layoutX="44.0" layoutY="218.0" prefHeight="17.0" prefWidth="120.0"
             text="Subject 3 (Science):" textFill="WHITE" />
      <TextField fx:id="grade3Txt" layoutX="181.0" layoutY="214.0"
                 prefHeight="25.0" prefWidth="151.0" />

      <!-- FIX: Calculate Average button now connected to calculateAverage() -->
      <Button layoutX="181.0" layoutY="254.0"
              mnemonicParsing="false"
              onAction="#calculateAverage"
              prefHeight="25.0" prefWidth="151.0"
              style="-fx-background-color: #2980b9;"
              text="Calculate Average" textFill="WHITE" />

      <!-- Average display label -->
      <Label fx:id="averageLbl" layoutX="39.0" layoutY="295.0"
             prefHeight="20.0" prefWidth="400.0"
             style="-fx-background-color: grey;"
             text="   Calculated Average:" textFill="WHITE">
         <font><Font size="14.0" /></font>
      </Label>

      <!-- Result / error message -->
      <Label fx:id="resultLbl" layoutX="39.0" layoutY="330.0"
             prefHeight="20.0" prefWidth="487.0"
             textFill="WHITE" wrapText="true" />

      <!-- Action Buttons -->
      <Button layoutX="44.0" layoutY="400.0"
              mnemonicParsing="false"
              onAction="#handleSaveGrades"
              prefHeight="30.0" prefWidth="140.0"
              style="-fx-background-color: green;"
              text="Save Grades" textFill="WHITE" />

      <Button layoutX="208.0" layoutY="400.0"
              mnemonicParsing="false"
              onAction="#clearFields"
              prefHeight="30.0" prefWidth="140.0"
              style="-fx-background-color: gray;"
              text="Clear Fields" textFill="WHITE" />

      <Button layoutX="372.0" layoutY="400.0"
              mnemonicParsing="false"
              onAction="#handleBack"
              prefHeight="30.0" prefWidth="140.0"
              style="-fx-background-color: red;"
              text="Back To Dashboard" textFill="WHITE" />

   </children>
</AnchorPane>
