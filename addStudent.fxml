<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="500.0" spacing="15.0"
      style="-fx-background-color: #1a3a5c;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.project.AddStudentController">

    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
    </padding>

    <!-- Title -->
    <Label text="Add New Student" textFill="WHITE" alignment="CENTER">
        <font>
            <Font name="Arabic Typesetting" size="32.0" />
        </font>
    </Label>

    <!-- Student ID -->
    <Label text="Student ID:" textFill="#aad4f5">
        <font><Font name="Arabic Typesetting" size="18.0" /></font>
    </Label>
    <TextField fx:id="idTxt" promptText="Enter Student ID (numbers only)"
               style="-fx-background-color: #f0f8ff; -fx-font-size: 15px; -fx-pref-height: 35px;" />

    <!-- Student Name -->
    <Label text="Student Name:" textFill="#aad4f5">
        <font><Font name="Arabic Typesetting" size="18.0" /></font>
    </Label>
    <TextField fx:id="nameTxt" promptText="Enter Student Name"
               style="-fx-background-color: #f0f8ff; -fx-font-size: 15px; -fx-pref-height: 35px;" />

    <!-- Major -->
    <Label text="Major:" textFill="#aad4f5">
        <font><Font name="Arabic Typesetting" size="18.0" /></font>
    </Label>
    <TextField fx:id="majorTxt" promptText="Enter Major (e.g. Computer Science)"
               style="-fx-background-color: #f0f8ff; -fx-font-size: 15px; -fx-pref-height: 35px;" />

    <!-- Result Label -->
    <Label fx:id="resultLbl" prefHeight="30.0" prefWidth="380.0"
           textFill="#ff6b6b" wrapText="true">
        <font><Font name="Arabic Typesetting" size="16.0" /></font>
    </Label>

    <!-- Buttons -->
    <AnchorPane prefHeight="50.0" prefWidth="400.0">
        <Button fx:id="addBtn" layoutX="20.0" layoutY="5.0"
                onAction="#addStudent" text="Add Student"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-pref-width: 150px; -fx-pref-height: 38px; -fx-cursor: hand;">
            <font><Font name="Arabic Typesetting" size="16.0" /></font>
        </Button>
        <Button layoutX="230.0" layoutY="5.0"
                onAction="#goBack" text="Back to Dashboard"
                style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-pref-width: 170px; -fx-pref-height: 38px; -fx-cursor: hand;">
            <font><Font name="Arabic Typesetting" size="16.0" /></font>
        </Button>
    </AnchorPane>

</VBox>
