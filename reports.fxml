<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0"
            prefWidth="600.0"
            style="-fx-background-color: #1e3d59;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.project.ReportsController">

    <children>

        <VBox alignment="CENTER"
              spacing="25.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">

            <children>

                <Label text="View Reports"
                       textFill="WHITE">

                    <font>
                        <Font size="28.0"/>
                    </font>

                </Label>

                <Label fx:id="totalStudentsLbl"
                       text="Total Students : 0"
                       textFill="WHITE">

                    <font>
                        <Font size="20.0"/>
                    </font>

                </Label>

                <Label fx:id="highestGradeLbl"
                       text="Highest Grade : 0"
                       textFill="WHITE">

                    <font>
                        <Font size="20.0"/>
                    </font>

                </Label>

                <Label fx:id="generalAverageLbl"
                       text="General Average : 0"
                       textFill="WHITE">

                    <font>
                        <Font size="20.0"/>
                    </font>

                </Label>

                <Button mnemonicParsing="false"
                        onAction="#handleBackButton"
                        prefHeight="40.0"
                        prefWidth="100.0"
                        style="-fx-background-color: #e82626;"
                        text="Back"
                        textFill="WHITE"/>

            </children>

        </VBox>

    </children>

</AnchorPane>
